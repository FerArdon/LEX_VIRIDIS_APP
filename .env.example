# LEX VIRIDIS - Configuración de Variables de Entorno
# Copiar este archivo a .env y configurar los valores

# === IA / Gemini API ===
# Obtener API key en: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# === CORS Configuration (FastAPI) ===
# Orígenes permitidos para la API web (separados por comas)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# === Debug Mode ===
# True para desarrollo, False para producción
DEBUG=False

# === Database ===
# Opcional: Ruta personalizada para la base de datos
# DB_PATH=LEX_VIRIDIS_DB/legislacion_ambiental.db

# === Logging ===
# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# === Security ===
# Opcional: Clave secreta para sesiones (generada automáticamente si no se especifica)
# SECRET_KEY=your-secret-key-here

# === Server Configuration (Web App) ===
# HOST=0.0.0.0
# PORT=8000
# RELOAD=False

# === Backup Configuration ===
# BACKUP_RETENTION_DAYS=30
# MAX_BACKUPS=10

# === Cache Configuration ===
# CACHE_TTL_SECONDS=3600
# MAX_CACHE_SIZE=100
